<idea-plugin>
    <id>com.code-comprehension-research.confusion-atoms-refactor</id>
    <name>Confusion Atoms Refactor</name>
    <vendor>Code Comprehension Research</vendor>

    <description><![CDATA[
        Detects and refactors <b>atoms of confusion</b> in Java code directly in the editor.
        <br/><br/>
        Atoms of confusion are small syntactic patterns that are valid and correct,
        but often misread by developers. This plugin reports nine of them as inspections
        and offers quick fixes that rewrite the code into a clearer form:
        <ul>
            <li>Conditional operator</li>
            <li>Infix operator precedence</li>
            <li>Pre- and post-increment/decrement</li>
            <li>Arithmetic as logic</li>
            <li>Type conversion</li>
            <li>Omitted curly braces</li>
            <li>Logic as control flow</li>
            <li>Change of literal encoding</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
<h4>1.0.0</h4>
<ul>
    <li>Initial release.</li>
    <li>Added 9 inspections for atoms of confusion in Java code.</li>
    <li>Added quick fixes that refactor each detected atom into a clearer equivalent.</li>
</ul>
]]>
    </change-notes>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
                language="JAVA"
                displayName="Operador condicional (átomo de confusão)"
                groupName="Confusion Atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.ConditionalOperatorInspection"/>
        <localInspection
                language="JAVA"
                displayName="Precedência de operadores infix (átomo de confusão)"
                groupName="Confusion Atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.InfixOperatorPrecedenceInspection"/>
        <localInspection
                language="JAVA"
                displayName="Pré-incremento/decremento (átomo de confusão)"
                groupName="Confusion Atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.PreIncrementDecrementInspection"/>
        <localInspection
                language="JAVA"
                displayName="Pós-incremento/decremento (átomo de confusão)"
                groupName="Confusion Atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.PostIncrementDecrementInspection"/>
        <localInspection
                language="JAVA"
                displayName="Aritmética como lógica (átomo de confusão)"
                groupName="Confusion Atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.ArithmeticAsLogicInspection"/>
        <localInspection
                language="JAVA"
                displayName="Narrowing type conversion (confusion atom)"
                groupName="Confusion Atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.TypeConversionInspection"/>
        <localInspection
                language="JAVA"
                displayName="Omitted curly braces confusion atom"
                groupPath="Java"
                groupName="Confusion atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.OmittedCurlyBracesInspection"/>
        <localInspection
                language="JAVA"
                displayName="Logic As Control Flow (confusion atom)"
                groupName="Confusion Atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.LogicAsControlFlowInspection"/>
        <localInspection
                language="JAVA"
                displayName="Change of Literal Encoding (confusion atom)"
                groupName="Confusion Atoms"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.anon.aocrefactor.inspection.ChangeOfLiteralEncodingInspection"/>
    </extensions>
</idea-plugin>